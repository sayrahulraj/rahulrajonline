# ---------------------------------------------------------------------------
# Backend (Vercel serverless functions) — set these in Vercel Project Settings
# → Environment Variables. Do NOT prefix these with VITE_ (they must stay
# server-side only).
# ---------------------------------------------------------------------------

# Neon Postgres connection string
# Neon dashboard → your project → Connection Details → "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign admin session tokens (any long random string —
# e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Frontend (Vite) — these ARE bundled into the client, so only put public
# values here. Must be prefixed with VITE_ to be exposed to the browser.
# ---------------------------------------------------------------------------

# EmailJS (emailjs.com) — used by the Contact page to send messages
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxx
